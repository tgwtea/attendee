# Obtain a token from BotFather. Never commit the real token.
TELEGRAM_BOT_TOKEN=
DATABASE_URL=sqlite+aiosqlite:///./data/attendee.db
APP_TIMEZONE=Asia/Singapore
# Comma-separated positive Telegram user IDs or a JSON array.
# Only `attendee-setup --organization <slug>` applies them, to that organization only.
BOOTSTRAP_ADMIN_IDS=
# The organization slug that this bot serves. Create it first with attendee-setup.
BOT_ORGANIZATION=
LOG_LEVEL=INFO
BACKUP_DIR=./data/backups
